						<string>import Foundation
import Cocoa
import ApplicationServices

func copyAttribute(_ element: AXUIElement, _ name: String) -&gt; AnyObject? {
    var value: CFTypeRef?
    let result = AXUIElementCopyAttributeValue(element, name as CFString, &amp;value)
    guard result == .success, let value else { return nil }
    return value
}

func axPoint(_ obj: AnyObject?) -&gt; CGPoint? {
    guard let value = obj else { return nil }
    let ax = value as! AXValue
    var point = CGPoint.zero
    guard AXValueGetValue(ax, .cgPoint, &amp;point) else { return nil }
    return point
}

func axSize(_ obj: AnyObject?) -&gt; CGSize? {
    guard let value = obj else { return nil }
    let ax = value as! AXValue
    var size = CGSize.zero
    guard AXValueGetValue(ax, .cgSize, &amp;size) else { return nil }
    return size
}

func pad(_ label: String, _ width: Int = 12) -&gt; String {
    let s = label + ":"
    if s.count &gt;= width { return s + " " }
    return s + String(repeating: " ", count: width - s.count)
}

guard AXIsProcessTrusted() else {
    fputs("Accessibility permission is not enabled.\n", stderr)
    exit(1)
}

guard let app = NSWorkspace.shared.frontmostApplication else {
    fputs("Could not get frontmost application.\n", stderr)
    exit(1)
}

let appName = app.localizedName ?? "(unknown)"
let axApp = AXUIElementCreateApplication(app.processIdentifier)

guard let focusedObj = copyAttribute(axApp, kAXFocusedWindowAttribute) else {
    fputs("Could not get focused window.\n", stderr)
    exit(1)
}

let win = focusedObj as! AXUIElement

let title = (copyAttribute(win, kAXTitleAttribute) as? String) ?? "(untitled)"
let role = (copyAttribute(win, kAXRoleAttribute) as? String) ?? "(unknown)"
let subrole = (copyAttribute(win, kAXSubroleAttribute) as? String) ?? "(unknown)"
let minimized = (copyAttribute(win, kAXMinimizedAttribute) as? Bool) ?? false
let focused = (copyAttribute(win, kAXFocusedAttribute) as? Bool) ?? true

let pos = axPoint(copyAttribute(win, kAXPositionAttribute))
let size = axSize(copyAttribute(win, kAXSizeAttribute))

let x = Int(pos?.x ?? 0)
let y = Int(pos?.y ?? 0)
let w = Int(size?.width ?? 0)
let h = Int(size?.height ?? 0)

let textOutput = """
\(pad("App"))\(appName)
\(pad("Title"))\(title)
\(pad("Role"))\(role)
\(pad("Subrole"))\(subrole)
\(pad("Focused"))\(focused)
\(pad("Minimized"))\(minimized)
\(pad("Position"))X=\(x)  Y=\(y)
\(pad("Size"))W=\(w)  H=\(h)
\(pad("Bounds"))\(x),\(y) \(w)x\(h)
"""

let json = """
{
  "app": "\(appName.replacingOccurrences(of: "\"", with: "\\\""))",
  "title": "\(title.replacingOccurrences(of: "\"", with: "\\\""))",
  "role": "\(role)",
  "subrole": "\(subrole)",
  "focused": \(focused),
  "minimized": \(minimized),
  "x": \(x),
  "y": \(y),
  "width": \(w),
  "height": \(h)
}
"""

print(textOutput + "\nJSON:\n" + json)</string>
