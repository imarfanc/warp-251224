						<string>#!/bin/bash

# Get current value (KM exposes variables as KMVAR_ env vars automatically)
v="$KMVAR_myVar_test264"

# Print old value to terminal
echo 'The variable is "'"$v"'"'

# Set new value
osascript -e 'tell application "Keyboard Maestro Engine" to setvariable "myVar_test264" to "4444"'</string>
