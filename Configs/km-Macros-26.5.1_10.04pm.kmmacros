						<string>;void (async function copyFirstAndSecondImageURLsForKeyboardMaestro() {
  const kmCompletion = typeof completion === 'function' ? completion : null;

  function finish(payload) {
    if (kmCompletion) {
      kmCompletion(JSON.stringify(payload, null, 2));
    }

    return payload;
  }
  function getImageURL(el) {
    if (el instanceof HTMLImageElement) {
      return el.currentSrc || el.src || el.getAttribute('src') || '';
    }

    // Midjourney Explore renders images as CSS backgrounds with image-set().
    // Prefer the last URL because it is usually the higher-density asset.
    const bg = window.getComputedStyle(el).backgroundImage;
    const urls = [...(bg?.matchAll(/url\(["']?([^"')]+)["']?\)/g) || [])]
      .map((match) =&gt; match[1]);
    return urls.at(-1) || urls[0] || '';
  }

  function isVisibleImage(el) {
    const rect = el.getBoundingClientRect();
    return rect.width &gt;= 40 &amp;&amp; rect.height &gt;= 40 &amp;&amp; rect.bottom &gt; 0 &amp;&amp; rect.right &gt; 0 &amp;&amp;
      rect.top &lt; window.innerHeight &amp;&amp; rect.left &lt; window.innerWidth;
  }

  function rectSnapshot(rect) {
    return {
      x: rect.x,
      y: rect.y,
      width: rect.width,
      height: rect.height,
    };
  }

  function collectImageElements() {
    const elements = [...document.querySelectorAll('img')];

    for (const el of document.querySelectorAll('*')) {
      const bg = window.getComputedStyle(el).backgroundImage;
      if (bg &amp;&amp; bg !== 'none' &amp;&amp; bg.includes('url(')) elements.push(el);
    }

    return elements;
  }

  function findVisibleImageCandidates() {
    const seen = new Set();

    return collectImageElements()
      .filter((el) =&gt; {
        const url = getImageURL(el);
        if (!url || seen.has(url) || !isVisibleImage(el)) return false;

        seen.add(url);
        return true;
      })
      .map((el, index) =&gt; ({
        el,
        index: index + 1,
        rect: el.getBoundingClientRect(),
        url: getImageURL(el),
      }))
      // Sort by visual position so "first" and "second" match what you see.
      .sort((a, b) =&gt; a.rect.top - b.rect.top || a.rect.left - b.rect.left);
  }

  function copyTextWithExecCommand(text) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = [
      'position:fixed',
      'top:0',
      'left:0',
      'width:1px',
      'height:1px',
      'opacity:0',
      'pointer-events:none',
      'z-index:-1',
    ].join(';');

    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, ta.value.length);

    let copied = false;
    try {
      copied = document.execCommand('copy');
    } finally {
      document.body.removeChild(ta);
    }

    return copied;
  }

  // Find the first and second visible image-like elements in visual order.
  const imageCandidates = findVisibleImageCandidates();

  if (imageCandidates.length &lt; 2) {
    const result = {
      copiedURL: null,
      copiedURLs: [],
      clickedCopyButton: false,
      error: 'Less than 2 visible images found.',
      imageCount: imageCandidates.length,
    };
    console.error(result.error, imageCandidates);
    return finish(result);
  }

  const [firstImage, secondImage] = imageCandidates;
  const result = {
    firstImage: {
      url: firstImage.url,
      rect: rectSnapshot(firstImage.rect),
    },
    secondImage: {
      url: secondImage.url,
      rect: rectSnapshot(secondImage.rect),
    },
    copiedURL: null,
    copiedURLs: [],
    clickedCopyButton: false,
    error: null,
  };

  console.log('First image candidate:', firstImage.url, firstImage.rect);
  console.log('Second image candidate:', secondImage.url, secondImage.rect);

  if (copyTextWithExecCommand(secondImage.url)) {
    result.copiedURL = secondImage.url;
    result.copiedURLs.push(secondImage.url);
    console.log('✅ Copied second image URL:', secondImage.url);
  } else {
    result.error = 'execCommand copy failed';
    console.error('❌ execCommand copy failed');
  }

  console.log('COPY_2ND_IMAGE_URL_DONE', result);
  return finish(result);
})().catch((error) =&gt; {
  const result = {
    copiedURL: null,
    copiedURLs: [],
    clickedCopyButton: false,
    error: error?.message || String(error),
  };
  console.error('COPY_2ND_IMAGE_URL_FAILED', error);
  if (typeof completion === 'function') {
    completion(JSON.stringify(result, null, 2));
  }
  return result;
});
</string>
