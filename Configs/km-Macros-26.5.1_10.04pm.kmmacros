						<string>;(() =&gt; {
    "use strict";

    const URL = "https://arfan-simple-apps.val.run/THE-SIMPLE-APPS/_MAIN/html-gallery-v1a/html-gallery-data/keyboard-maestro/web-trigger-page6/index.html";
    const TARGET_APP = "Helium";

    const sys = Application.currentApplication();
    sys.includeStandardAdditions = true;

    try {
        sys.doShellScript(`/usr/bin/open -a "${TARGET_APP}" "${URL}"`);
        return `✅ Opened in ${TARGET_APP}`;
    } catch (_) {
        sys.doShellScript(`/usr/bin/open "${URL}"`);
        return `⚠️ ${TARGET_APP} unavailable. Fell back to default browser.`;
    }
})();</string>
