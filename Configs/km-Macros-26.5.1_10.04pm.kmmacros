						<string>import Foundation
import AppKit
import ApplicationServices

let json = """
{
  "app": "Google Chrome",
  "x": 62,
  "y": 41,
  "width": 1300,
  "height": 907
}
"""

struct WindowSpec: Decodable {
    let app: String
    let x: Double
    let y: Double
    let width: Double
    let height: Double
}

func setCGPoint(_ element: AXUIElement, attribute: String, x: Double, y: Double) {
    var point = CGPoint(x: x, y: y)
    if let value = AXValueCreate(.cgPoint, &amp;point) {
        AXUIElementSetAttributeValue(element, attribute as CFString, value)
    }
}

func setCGSize(_ element: AXUIElement, attribute: String, width: Double, height: Double) {
    var size = CGSize(width: width, height: height)
    if let value = AXValueCreate(.cgSize, &amp;size) {
        AXUIElementSetAttributeValue(element, attribute as CFString, value)
    }
}

let spec = try JSONDecoder().decode(WindowSpec.self, from: Data(json.utf8))

guard let app = NSWorkspace.shared.runningApplications.first(where: {
    $0.localizedName == spec.app
}) else {
    throw NSError(domain: "WindowResize", code: 1, userInfo: [
        NSLocalizedDescriptionKey: "App not running: \(spec.app)"
    ])
}

let appElement = AXUIElementCreateApplication(app.processIdentifier)

var windowValue: AnyObject?
let result = AXUIElementCopyAttributeValue(
    appElement,
    kAXFocusedWindowAttribute as CFString,
    &amp;windowValue
)

guard result == .success, let window = windowValue else {
    throw NSError(domain: "WindowResize", code: 2, userInfo: [
        NSLocalizedDescriptionKey: "Could not find focused window for \(spec.app)"
    ])
}

let targetWindow = window as! AXUIElement

setCGPoint(targetWindow, attribute: kAXPositionAttribute, x: spec.x, y: spec.y)
setCGSize(targetWindow, attribute: kAXSizeAttribute, width: spec.width, height: spec.height)
</string>
