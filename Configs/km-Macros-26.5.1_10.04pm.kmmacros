						<string>const specs = [
  JSON.parse(kmvar.varJson_App1),
  JSON.parse(kmvar.varJson_App2)
];

const se = Application("System Events");

function titleMatches(windowName, titlePattern) {
  if (!windowName || !titlePattern) {
    return false;
  }

  const parts = titlePattern
    .split("-")
    .map(part =&gt; part.trim())
    .filter(Boolean);

  return parts.some(part =&gt; windowName.includes(part));
}

function findWindowByTitle(proc, titlePattern) {
  const windows = proc.windows;

  for (let i = 0; i &lt; windows.length; i++) {
    const win = windows[i];
    const name = win.name();

    if (titleMatches(name, titlePattern)) {
      return win;
    }
  }

  return null;
}

function fallbackWindow(proc, index) {
  return proc.windows[index];
}

for (let i = 0; i &lt; specs.length; i++) {
  const spec = specs[i];
  const proc = se.processes.byName(spec.app);

  if (!proc.exists()) {
    throw new Error(`App not running: ${spec.app}`);
  }

  const win = findWindowByTitle(proc, spec.title) || fallbackWindow(proc, i);

  if (!win || !win.exists()) {
    throw new Error(`Window not found for ${spec.app}: ${spec.title}`);
  }

  win.position = [spec.x, spec.y];
  win.size = [spec.width, spec.height];
}
