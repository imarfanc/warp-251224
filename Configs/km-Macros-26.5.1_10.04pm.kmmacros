						<string>// Settings
const leftInset = 0;
const rightInset = 100;
const stableChecksNeeded = 3;
const checkDelaySeconds = 0.12;

// Front window
const se = Application("System Events");
const frontProc = se.processes.whose({ frontmost: true })[0];
const win = frontProc.windows[0];

// Helpers
function boundsOf(win) {
  const pos = win.position();
  const size = win.size();
  return [pos[0], pos[1], size[0], size[1]].join(",");
}

// Fill window
frontProc.menuBars[0]
  .menuBarItems.byName("Window")
  .menus[0]
  .menuItems.byName("Fill")
  .click();

// Wait for fill animation
let last = "";
let stableCount = 0;

while (stableCount &lt; stableChecksNeeded) {
  delay(checkDelaySeconds);

  const current = boundsOf(win);

  if (current === last) {
    stableCount++;
  } else {
    stableCount = 0;
    last = current;
  }
}

// Apply insets
const pos = win.position();
const size = win.size();

win.position = [pos[0] + leftInset, pos[1]];
win.size = [size[0] - leftInset - rightInset, size[1]];
</string>
