						<key>Text</key>
						<string>import AppKit

let appNames = [
    "Obsidian",
    "Google Chrome Beta",
    "GitHub Desktop",
    "Brave Browser",
    "Comet",
    "WhatsApp",
    "Warp",
    "System Settings",
    "Preview"
]

var closedApps: [String] = []
var notRunning: [String] = []

for appName in appNames {
    let matchingApps = NSWorkspace.shared.runningApplications.filter {
        $0.localizedName == appName
    }
    
    if matchingApps.isEmpty {
        notRunning.append(appName)
        continue
    }
    
    for app in matchingApps {
        if app.terminate() || app.forceTerminate() {
            closedApps.append(appName)
        }
    }
}

print("Closed:")
for name in closedApps {
    print("  • \(name)")
}

if !notRunning.isEmpty {
    print("\nNot running:")
    for name in notRunning {
        print("  • \(name)")
    }
}</string>
