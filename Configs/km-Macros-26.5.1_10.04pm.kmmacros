						<string>import Foundation
import Cocoa
import ApplicationServices

// ======================================================
// SETTINGS
// Edit only this section
// ======================================================

struct SingleWindowRule {
    let appNames: [String]
    let frame: CGRect
    let label: String
}

struct IndexedWindowRule {
    let appNames: [String]
    let windowIndex: Int   // 0-based: 0 = first window, 1 = second window
    let frame: CGRect
    let label: String
}

// Apps that usually have one relevant window
let singleWindowRules: [SingleWindowRule] = [
    SingleWindowRule(
        appNames: ["Keyboard Maestro", "Keyboard Maestro Editor"],
        frame: CGRect(x: 210, y: 200, width: 1000, height: 650),
        label: "Keyboard Maestro"
    ),
    SingleWindowRule(
        appNames: ["Finder"],
        frame: CGRect(x: 70, y: 100, width: 920, height: 580),
        label: "Finder"
    ),
    SingleWindowRule(
        appNames: ["Helium"],
        frame: CGRect(x: 60, y: 60, width: 1200, height: 880),
        label: "Helium"
    ),
    SingleWindowRule(
        appNames: ["Zen", "Zen Browser"],
        frame: CGRect(x: 63, y: 40, width: 1343, height: 908),
        label: "Zen"
    ),
    SingleWindowRule(
        appNames: ["Zed"],
        frame: CGRect(x: 80, y: 70, width: 1200, height: 860),
        label: "Zed"
    )
]

// Apps where you want windows by order, not title
let indexedWindowRules: [IndexedWindowRule] = [
    IndexedWindowRule(
        appNames: ["Cursor"],
        windowIndex: 0,
        frame: CGRect(x: 60, y: 40, width: 1250, height: 900),
        label: "Cursor 1"
    ),
    IndexedWindowRule(
        appNames: ["Cursor"],
        windowIndex: 1,
        frame: CGRect(x: 112, y: 77, width: 1263, height: 878),
        label: "Cursor 2"
    ),
    IndexedWindowRule(
        appNames: ["Google Chrome", "Chrome"],
        windowIndex: 0,
        frame: CGRect(x: 60, y: 40, width: 1250, height: 900),
        label: "Chrome 1"
    ),
    IndexedWindowRule(
        appNames: ["Google Chrome", "Chrome"],
        windowIndex: 1,
        frame: CGRect(x: 112, y: 77, width: 1263, height: 878),
        label: "Chrome 2"
    )
]


// ======================================================
// HELPERS
// ======================================================

func copyAttribute(_ element: AXUIElement, _ name: String) -&gt; AnyObject? {
    var value: CFTypeRef?
    let result = AXUIElementCopyAttributeValue(element, name as CFString, &amp;value)
    guard result == .success, let value else { return nil }
    return value
}

func setAttribute(_ element: AXUIElement, _ name: String, _ value: CFTypeRef) -&gt; Bool {
    AXUIElementSetAttributeValue(element, name as CFString, value) == .success
}

func makeAXValue(_ point: CGPoint) -&gt; AXValue {
    var p = point
    return AXValueCreate(.cgPoint, &amp;p)!
}

func makeAXValue(_ size: CGSize) -&gt; AXValue {
    var s = size
    return AXValueCreate(.cgSize, &amp;s)!
}

func isStandardWindow(_ window: AXUIElement) -&gt; Bool {
    let role = copyAttribute(window, kAXRoleAttribute) as? String
    let subrole = copyAttribute(window, kAXSubroleAttribute) as? String
    return role == kAXWindowRole &amp;&amp; subrole == kAXStandardWindowSubrole
}

func isMinimized(_ window: AXUIElement) -&gt; Bool {
    (copyAttribute(window, kAXMinimizedAttribute) as? Bool) ?? false
}

func windowTitle(_ window: AXUIElement) -&gt; String {
    (copyAttribute(window, kAXTitleAttribute) as? String) ?? "(untitled)"
}

func setWindowFrame(_ window: AXUIElement, _ frame: CGRect) -&gt; Bool {
    let okPos = setAttribute(window, kAXPositionAttribute, makeAXValue(frame.origin))
    let okSize = setAttribute(window, kAXSizeAttribute, makeAXValue(frame.size))
    return okPos &amp;&amp; okSize
}

func findRunningApp(namedAnyOf names: [String]) -&gt; NSRunningApplication? {
    let apps = NSWorkspace.shared.runningApplications
    for candidate in names {
        if let app = apps.first(where: { $0.localizedName == candidate }) {
            return app
        }
    }
    return nil
}

func standardWindows(for app: NSRunningApplication) -&gt; [AXUIElement] {
    let axApp = AXUIElementCreateApplication(app.processIdentifier)

    guard let raw = copyAttribute(axApp, kAXWindowsAttribute) as? [AnyObject] else {
        return []
    }

    return raw
        .map { $0 as! AXUIElement }
        .filter { isStandardWindow($0) &amp;&amp; !isMinimized($0) }
}

func firstWindow(forAppNames appNames: [String]) -&gt; AXUIElement? {
    guard let app = findRunningApp(namedAnyOf: appNames) else { return nil }
    let windows = standardWindows(for: app)
    return windows.first
}

func indexedWindow(forAppNames appNames: [String], index: Int) -&gt; AXUIElement? {
    guard let app = findRunningApp(namedAnyOf: appNames) else { return nil }
    let windows = standardWindows(for: app)
    guard index &gt;= 0 &amp;&amp; index &lt; windows.count else { return nil }
    return windows[index]
}

func describeFrame(_ frame: CGRect) -&gt; String {
    "\(Int(frame.origin.x)),\(Int(frame.origin.y)) \(Int(frame.size.width))x\(Int(frame.size.height))"
}


// ======================================================
// MAIN
// ======================================================

guard AXIsProcessTrusted() else {
    fputs("Accessibility permission is not enabled.\n", stderr)
    exit(1)
}

var lines: [String] = []

// Single-window apps
for rule in singleWindowRules {
    guard let win = firstWindow(forAppNames: rule.appNames) else {
        lines.append("\(rule.label): window not found")
        continue
    }

    let title = windowTitle(win)
    let ok = setWindowFrame(win, rule.frame)

    if ok {
        lines.append("\(rule.label): resized → \(title) → \(describeFrame(rule.frame))")
    } else {
        lines.append("\(rule.label): failed → \(title)")
    }
}

// Indexed windows
for rule in indexedWindowRules {
    guard let win = indexedWindow(forAppNames: rule.appNames, index: rule.windowIndex) else {
        lines.append("\(rule.label): window not found")
        continue
    }

    let title = windowTitle(win)
    let ok = setWindowFrame(win, rule.frame)

    if ok {
        lines.append("\(rule.label): resized → \(title) → \(describeFrame(rule.frame))")
    } else {
        lines.append("\(rule.label): failed → \(title)")
    }
}

print(lines.joined(separator: "\n"))</string>
