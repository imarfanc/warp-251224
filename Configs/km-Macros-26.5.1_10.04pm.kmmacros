  const ADDITIONAL_INFO_SELECTOR = `${ABOUT_PANEL_SELECTOR} #additional-info-container`;
  const MORE_BUTTON_SELECTORS = [
    "yt-description-preview-view-model button.ytTruncatedTextAbsoluteButton",
    "yt-page-header-view-model .ytTruncatedTextAbsoluteButton",
    ".ytTruncatedTextInlineButton",
  ];

  const kmCompletion = typeof completion === "function" ? completion : null;
  const sleep = (ms) =&gt; new Promise((resolve) =&gt; setTimeout(resolve, ms));

  const clean = (value) =&gt;
    String(value || "")
      .replace(/\s+/g, " ")
      .trim();

  const textOf = (el) =&gt; clean(el?.innerText || el?.textContent || "");

  const absoluteUrl = (value) =&gt; {
    if (!value) return "";
    try {
      return new URL(value, location.href).href;
    } catch {
      return value;
    }
  };

  const firstElement = (selectors, root = document) =&gt; {
    for (const selector of selectors) {
      const el = root.querySelector(selector);
      if (el) return el;
    }
    return null;
  };

  const isVisible = (el) =&gt; Boolean(el &amp;&amp; el.offsetParent !== null);
  const firstVisible = (selectors) =&gt;
    selectors.map((selector) =&gt; document.querySelector(selector)).find(isVisible) || null;

  const finish = (payload) =&gt; {
    if (kmCompletion) kmCompletion(JSON.stringify(payload, null, 2));
    return payload;
  };

  /**
   * execCommand("copy") after await often needs workarounds: readonly textareas
   * may not copy in Safari / some Chromium builds; user activation may be gone.
   */
  const copyTextWithExecCommand = (text) =&gt; {
    try {
      globalThis.focus?.();
    } catch {
      /* ignore */
    }

    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("aria-hidden", "true");
    ta.style.cssText =
      "position:fixed;top:0;left:0;width:16px;height:16px;margin:0;padding:0;border:0;outline:0;" +
      "opacity:0.02;z-index:2147483647;resize:none;overflow:auto;appearance:none;" +
      "-webkit-appearance:none;pointer-events:auto";
    (document.documentElement || document.body).appendChild(ta);
    ta.focus({ preventScroll: true });
    ta.select();
    ta.setSelectionRange(0, ta.value.length);
    let copied = false;
    try {
      copied = document.execCommand("copy");
    } finally {
      ta.remove();
    }
    return copied;
  };

  /** Fallback when textarea copy fails (selection inside contenteditable). */
  const copyTextWithContentEditable = (text) =&gt; {
    const div = document.createElement("div");
    div.contentEditable = "true";
    div.textContent = text;
    div.setAttribute("aria-hidden", "true");
    div.style.cssText =
      "position:fixed;top:0;left:0;max-width:160px;max-height:80px;opacity:0.02;" +
      "z-index:2147483647;overflow:hidden;white-space:pre-wrap;pointer-events:auto";
    (document.documentElement || document.body).appendChild(div);
    const sel = getSelection();
    const range = document.createRange();
    let copied = false;
    try {
      range.selectNodeContents(div);
      sel.removeAllRanges();
      sel.addRange(range);
      div.focus();
      copied = document.execCommand("copy");
    } catch {
      /* ignore */
    } finally {
      sel?.removeAllRanges?.();
      div.remove();
    }
    return copied;
  };

  const copyJsonToClipboard = (text) =&gt; {
    if (copyTextWithExecCommand(text)) return "execCommand";
    if (copyTextWithContentEditable(text)) return "execCommand-contenteditable";
    return null;
  };

  const sourcesThumbUrl = (sources) =&gt; {
    if (!Array.isArray(sources) || sources.length === 0) return "";
    return absoluteUrl(sources[sources.length - 1]?.url || "");
  };

  const getYtInitialData = () =&gt;
    typeof globalThis.ytInitialData === "object" &amp;&amp; globalThis.ytInitialData !== null
      ? globalThis.ytInitialData
      : null;

  const extractInitialHeader = () =&gt; {
    const vm = getYtInitialData()?.header?.pageHeaderRenderer?.content?.pageHeaderViewModel;
    const empty = { title: "", handle: "", avatarImage: "", bannerImage: "" };
    if (!vm) return empty;

    const rows = vm.metadata?.contentMetadataViewModel?.metadataRows || [];
    const handle =
      rows
        .flatMap((row) =&gt; row.metadataParts || [])
        .map((part) =&gt; clean(part.text?.content || ""))
        .find((text) =&gt; text.startsWith("@")) || "";

    return {
      title: clean(vm.title?.dynamicTextViewModel?.text?.content || vm.title?.simpleText || ""),
      handle,
      avatarImage: sourcesThumbUrl(
        vm.image?.decoratedAvatarViewModel?.avatar?.avatarViewModel?.image?.sources
      ),
      bannerImage: sourcesThumbUrl(vm.banner?.imageBannerViewModel?.image?.sources),
    };
  };

  const getImageSrc = (selectors) =&gt; absoluteUrl(firstElement(selectors)?.getAttribute("src") || "");

  const scrapeDomHeader = () =&gt; {
    const handle =
      [...document.querySelectorAll("yt-content-metadata-view-model span.ytAttributedStringLinkInheritColor")]
        .map(textOf)
        .find((text) =&gt; text.startsWith("@")) || "";

    return {
      title: textOf(
        firstElement([
          "h1.dynamicTextViewModelH1 span.ytAttributedStringHost.ytAttributedStringWhiteSpacePreWrap",
          "h1.dynamicTextViewModelH1 span.ytAttributedStringHost",
          "yt-page-header-view-model h1 span.ytAttributedStringHost",
        ])
      ),
      handle,
      avatarImage: getImageSrc([
        "yt-page-header-view-model yt-avatar-shape img",
        "yt-decorated-avatar-view-model img",
        "yt-avatar-shape img",
      ]),
      bannerImage: getImageSrc([
        "#page-header-banner-sizer img.ytCoreImageHost",
        "#page-header-banner img.ytCoreImageHost",
        "#page-header-banner img",
        "yt-image-banner-view-model img",
      ]),
    };
  };

  const mergeHeader = (primary, fallback) =&gt; ({
    title: primary.title || fallback.title,
    handle: primary.handle || fallback.handle,
    avatarImage: primary.avatarImage || fallback.avatarImage,
    bannerImage: primary.bannerImage || fallback.bannerImage,
  });

  const findDescriptionMoreButton = () =&gt; {
    const direct = firstVisible(MORE_BUTTON_SELECTORS);
    if (direct) return direct;

    return [...document.querySelectorAll("yt-description-preview-view-model button")].find(
      (button) =&gt;
        isVisible(button) &amp;&amp;
        (/\.\.\.\s*more|\u2026\s*more|^more$/i.test(textOf(button)) ||
          /tap for more/i.test(button.getAttribute("aria-label") || ""))
    );
  };

  const openAboutPanel = async () =&gt; {
    const button = findDescriptionMoreButton();
    if (!button) return false;

    button.click();
    await sleep(400);

    const step = 120;
    for (let waited = 0; waited &lt; 8000; waited += step) {
      if (document.querySelector(ADDITIONAL_INFO_SELECTOR)) return true;
      await sleep(step);
    }
    return false;
  };

  const scrapeAboutPanelText = () =&gt; {
    const root = document.querySelector(ABOUT_PANEL_SELECTOR);
    if (!root) return "";

    return textOf(
      firstElement(
        ["#description-container", "yt-attributed-string", '[id*="description"]'],
        root
      )
    );
  };

  const scrapeAdditionalInfo = () =&gt; {
    const info = { joined: "", subscribers: "", videos: "" };
    const root = document.querySelector(ADDITIONAL_INFO_SELECTOR);
    if (!root) return info;

    for (const td of root.querySelectorAll("table tbody td")) {
      const text = textOf(td);
      if (/\bjoined\b/i.test(text) &amp;&amp; /\d{4}/.test(text)) {
        info.joined = text;
      } else if (/subscriber/i.test(text)) {
        info.subscribers = text;
      } else if (/\bvideos?\b/i.test(text) &amp;&amp; /[\d,.]+/.test(text)) {
        info.videos = text;
      }
    }

    return info;
  };

  const scrapeAboutPanel = async () =&gt; {
    const aboutPanelOpened = await openAboutPanel();
    if (!aboutPanelOpened) {
      return {
        aboutPanelOpened,
        aboutPanelText: "",
        joined: "",
        subscribers: "",
        videos: "",
      };
    }

    await sleep(200);
    const { joined, subscribers, videos } = scrapeAdditionalInfo();

    return {
      aboutPanelOpened,
      aboutPanelText: scrapeAboutPanelText(),
      joined,
      subscribers,
      videos,
    };
  };

  const channelBaseUrl = (canonicalUrl) =&gt; {
    if (canonicalUrl) return canonicalUrl.replace(/\/$/, "");

    try {
      const url = new URL(location.href);
      url.hash = "";
      url.search = "";
      url.pathname = url.pathname.replace(/\/(videos|streams)\/?$/i, "").replace(/\/$/, "");
      return url.href.replace(/\/$/, "");
    } catch {
      return "";
    }
  };

  const splitChannelTabUrls = (siteUrl, canonicalUrl) =&gt; {
    const base = channelBaseUrl(canonicalUrl);
    const tabUrls = {
      yt_channel_videos_url: base ? `${base}/videos` : "",
      yt_channel_streams_url: "",
    };

    try {
      const url = new URL(siteUrl);
      const path = url.pathname.replace(/\/$/, "");
      const currentTabUrl = `${url.origin}${url.pathname}${url.search}`.replace(/\/$/, "");

      if (/\/streams$/i.test(path)) {
        tabUrls.yt_channel_streams_url = currentTabUrl;
      } else if (/\/videos$/i.test(path)) {
        tabUrls.yt_channel_videos_url = currentTabUrl;
      }
    } catch {
      /* keep defaults */
    }

    return tabUrls;
  };

  const buildResult = ({ header, about, canonicalUrl, tabUrls }) =&gt; {
    const nowIso = new Date().toISOString();

    return {
      yt_channel_title: header.title,
      yt_channel_handle: header.handle,
      category: "",
      tags: [],
      about_panel_text: about.aboutPanelText,
      urls: {
        yt_channel_url: canonicalUrl || channelBaseUrl(""),
        yt_channel_videos_url: tabUrls.yt_channel_videos_url,
        yt_channel_streams_url: tabUrls.yt_channel_streams_url,
        yt_channel_banner_image: header.bannerImage,
        yt_channel_avatar_image: header.avatarImage,
      },
      joined_date: about.joined,
      subscribers_count: about.subscribers,
      videos_count: about.videos,
      metadata: {
        custom_image: "",
        date_created: nowIso,
        date_updated: nowIso,
        about_panel_opened: about.aboutPanelOpened,
      },
    };
  };

  const canonicalUrl =
    document.querySelector('link[rel="canonical"]')?.getAttribute("href") || "";
  const header = mergeHeader(scrapeDomHeader(), extractInitialHeader());
  const about = await scrapeAboutPanel();
  const tabUrls = splitChannelTabUrls(location.href, canonicalUrl);
  const result = buildResult({ header, about, canonicalUrl, tabUrls });
  const json = JSON.stringify(result, null, 2);

  console.log("YouTube channel header (v2):", result);
  console.log(json);

  const copyMethod = copyJsonToClipboard(json);
  if (copyMethod) {
    console.log("Copied to clipboard via %s.", copyMethod);
    return finish({ copied: true, method: copyMethod, result });
  }

  console.warn("Could not copy to clipboard. JSON is in the console.");
  return finish({ copied: false, method: null, result });
})().catch((error) =&gt; {
  const payload = { copied: false, method: null, error: error?.message || String(error) };
  console.error("YOUTUBE_CHANNEL_HEADER_V2_SCRAPE_FAILED", error);
  if (typeof completion === "function") completion(JSON.stringify(payload, null, 2));
  return payload;
});
</string>
