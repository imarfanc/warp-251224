						<string>#!/bin/bash
# Keyboard Maestro: Open URL in Helium (with graceful fallback)

URL="https://arfan-simple-apps.val.run/THE-SIMPLE-APPS/_MAIN/html-gallery-v1a/html-gallery-data/keyboard-maestro/web-trigger-page6/index.html"
TARGET_APP="Helium"

# Attempt to open in Helium
# `open -a` uses macOS LaunchServices, which resolves app names more reliably than AppleScript
if /usr/bin/open -a "$TARGET_APP" "$URL" 2&gt;/dev/null; then
    echo "✅ Opened in $TARGET_APP"
    exit 0
fi

# Fallback: default browser
echo "⚠️ $TARGET_APP not found or failed. Using default browser."
/usr/bin/open "$URL"
exit 0</string>
