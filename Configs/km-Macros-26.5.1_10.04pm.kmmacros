						<string>const se = Application("System Events");
const frontProc = se.processes.whose({ frontmost: true })[0];

if (!frontProc.exists()) {
  throw new Error("No front app found");
}

frontProc.menuBars[0]
  .menuBarItems.byName("Window")
  .menus[0]
  .menuItems.byName("Fill")
  .click();
</string>
