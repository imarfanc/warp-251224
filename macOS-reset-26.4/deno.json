{
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "tasks": {
    "bundle": "deno bundle deno-md-server/static/app.ts -o deno-md-server/static/app.js",
    "serve": "deno run --allow-read --allow-net --allow-env=LOG_TOKENS,LOG_STREAM deno-md-server/main.ts",
    "open": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --app=\"http://localhost:8000/\"",
    "start": "deno task bundle && deno task serve"
  }
}
